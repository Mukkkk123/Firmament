{
    "schemaVersion": 1,
    "id": "notfirmament",
    "version": "${version}",
    "name": "NotFirmament",
    "description": "NotFirmament powered by NEU",
    "authors": [
        {
            "name": "Linnea Gräf",
            "contact": {
                "email": "nea@nea.moe"
            }
        }
    ],
    "contact": {
        "discord": "https://discord.gg/64pFP94AWA",
        "sources": "https://github.com/nea89o/NotFirmament",
		"modrinth": "https://modrinth.com/mod/notfirmament"
    },
    "license": "GPL 3.0 or Later",
    "accessWidener": "notfirmament.accesswidener",
    "icon": "assets/notfirmament/logo.png",
    "environment": "client",
    "entrypoints": {
        "main": [
            "moe.nea.notfirmament.NotFirmament::onInitialize"
        ],
        "mm_shedaniel:early_risers": [
            "moe.nea.notfirmament.init.EarlyRiser"
        ],
        "client": [
            "moe.nea.notfirmament.NotFirmament::onClientInitialize"
        ],
        "rei_client": [
            "moe.nea.notfirmament.compat.rei.NotFirmamentReiPlugin"
        ],
		"rei_common": [
			"moe.nea.notfirmament.compat.rei.NotFirmamentReiCommonPlugin"
		],
        "modmenu": [
            "moe.nea.notfirmament.compat.modmenu.NotFirmamentModMenuPlugin"
        ],
		"jade": [
			"moe.nea.notfirmament.compat.jade.NotFirmamentJadePlugin"
		],
        "jarvis": [
            "moe.nea.notfirmament.jarvis.JarvisIntegration"
        ]
    },
    "mixins": [
        "notfirmament.mixins.json"
    ],
    "depends": {
        "fabric-api": ">=${fabric_api_version}",
        "fabric-language-kotlin": ">=${fabric_kotlin_version}",
        "minecraft": ">=${minecraft_version}"
    },
    "custom": {
        "modmenu": {
            "links": {
                "modmenu.discord": "https://discord.gg/64pFP94AWA"
            }
        },
        "mc-publish": {
            "dependencies": [
                "roughlyenoughitems(recommended){modrinth:rei}"
            ]
        }
    }
}
